<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AdvancedBudgetManager.view.page.IncomesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AdvancedBudgetManager.view.page"
    xmlns:utils="using:AdvancedBudgetManager.utils.misc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <utils:DateTimeFormatConverter x:Key="DateConverter"/>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- NARROW STATE -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <!-- Stack DatePickers -->
                        <Setter Target="incomesMainContentGrid.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="incomesMainContentGrid.ColumnDefinitions[1].Width" Value="*"/>

                        <!-- Stack main content -->
                        <Setter Target="incomesMainContentGrid.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="incomesMainContentGrid.ColumnDefinitions[1].Width" Value="0"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- WIDE STATE -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <!-- Side-by-side layout -->
                        <Setter Target="incomesMainContentGrid.ColumnDefinitions[0].Width" Value="2*"/>
                        <Setter Target="incomesMainContentGrid.ColumnDefinitions[0].Width" Value="*"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 1. TITLE -->
        <TextBlock
         Text="Incomes"
            FontFamily="SegoeUI"
            FontSize="28"
            FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,100,100,0">
            <StackPanel Grid.Row="1" Spacing="12">
                <!-- Checkbox -->
                <CheckBox Content="Month interval" x:Name="monthIntervalCheckBox" IsChecked="{x:Bind incomesViewModel.isMonthInterval, Mode=TwoWay}"/>

                <!-- DatePickers container -->
                <Grid x:Name="incomesDatePickerGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="startDatePicker" Header="Starting month" DayVisible="False" MonthVisible="True" YearVisible="True" Date="{x:Bind incomesViewModel.StartDate, Mode=TwoWay}" Grid.Column="0"/>
                    <DatePicker x:Name="endDatePicker" Header="Ending month" DayVisible="False" MonthVisible="True" YearVisible="True" Date="{x:Bind incomesViewModel.EndDate, Mode=TwoWay}" Visibility="{Binding IsChecked, ElementName=monthIntervalCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="1"/>
                </Grid>
            </StackPanel>

            <!-- 3. BUTTON ABOVE GRID -->
            <Button
                Grid.Row="2"
                Content="Display incomes"
                IsEnabled="{x:Bind incomesViewModel.IsValidDateSelection, Mode=TwoWay}"
                Command="{x:Bind incomesViewModel.DisplayIncomeStatisticsCommand}"
                Background="DodgerBlue"
                Foreground="White"
                HorizontalAlignment="Left"
                Margin="0,20,0,20"/>

            <!-- 4. MAIN CONTENT -->
            <Grid Grid.Row="3" x:Name="incomesMainContentGrid" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: GridView -->
                <StackPanel Grid.Column="0" Spacing="20">
                    <TextBlock Text="Incomes list" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"/>
                    <tableView:TableView x:Name="incomesTableView"
                                         ItemsSource="{x:Bind incomesViewModel.IncomeList, Mode=TwoWay}"
                                         Height="235"
                                         Grid.Column="0"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         GridLinesVisibility="All"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                        <tableView:TableView.Columns>
                        <tableView:TableViewTextColumn Header="Income name" Binding="{Binding Name}"/>
                        <tableView:TableViewTextColumn Header="Income category" Binding="{Binding Type}"/>
                        <tableView:TableViewTextColumn Header="Income value" Binding="{Binding Value}"/>
                            <tableView:TableViewTextColumn Header="Creation date" Binding="{Binding Date, Converter={StaticResource DateConverter}}"/>
                        </tableView:TableView.Columns>
                    </tableView:TableView>
                    <TextBlock Text="{x:Bind incomesViewModel.TotalIncomesMessage, Mode=TwoWay}" FontFamily="SegoeUI" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- RIGHT: PieChart -->
                <StackPanel Grid.Column="1" Spacing="20">
                    <TextBlock Text="Income categories chart" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"/>
                    <lvc:PieChart x:Name="incomeCategoriesPieChart"
                                  Series="{x:Bind incomesViewModel.IncomeCategoriesPieSeries, Mode=TwoWay}"
                                  Width="500" Height="350"
                                  TooltipPosition="Hidden" LegendPosition="Right"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 5. BOTTOM SECTION -->
        <StackPanel Grid.Row="4"  Spacing="12" Margin="0,-100,0,100">
            <DatePicker x:Name="incomeEvolutionYearDatePicker" Date="{x:Bind incomesViewModel.MonthlyIncomeEvolutionDate, Mode=TwoWay}"
                                        Header="Select year" DayVisible="False" MonthVisible="False" YearVisible="True"/>
            <Button Content="Display evolution" Background="DodgerBlue" Foreground="White" Margin="0,20,0,20" Command="{x:Bind incomesViewModel.DisplayMonthlyIncomeEvolutionCommand}"/>

            <TextBlock Text="Monthly incomes evolution" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <lvc:CartesianChart XAxes="{x:Bind incomesViewModel.MonthlyIncomeEvolutionAxis, Mode=TwoWay}"
                                            Series="{x:Bind incomesViewModel.MonthlyIncomeEvolutionSeries, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            Width="1400" Height="300"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
